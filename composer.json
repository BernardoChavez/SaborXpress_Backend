{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\Paquete1Seguridad\\": "Modules/Paquete1Seguridad/app/",
            "Modules\\Paquete2Usuarios\\": "Modules/Paquete2Usuarios/app/",
            "Modules\\Paquete3Configuracion\\": "Modules/Paquete3Configuracion/app/",
            "Modules\\Paquete4Inventarios\\": "Modules/Paquete4Inventarios/app/",
            "Modules\\Paquete5Ventas\\": "Modules/Paquete5Ventas/app/",
            "Modules\\Paquete6Produccion\\": "Modules/Paquete6Produccion/app/",
            "Modules\\Paquete7Comprobantes\\": "Modules/Paquete7Comprobantes/app/",
            "Modules\\Paquete8Compras\\": "Modules/Paquete8Compras/app/",
            "Modules\\Paquete9Auditoria\\": "Modules/Paquete9Auditoria/app/",
            "Modules\\Paquete10MesasReservasResenas\\": "Modules/Paquete10MesasReservasResenas/app/",
            "Modules\\Paquete10CombosyPromociones\\": "Modules/Paquete10CombosyPromociones/app/",
            "Modules\\Paquete11ServiciosEspeciales\\": "Modules/Paquete11ServiciosEspeciales/app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": false
        },
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
